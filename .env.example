# Backend configuration
# Copy this file to .env and fill in values as needed

# LLM service (optional — app works without an API key; LLM only enhances phrasing)
# Availability, policies, and hotel facts are always determined by the deterministic engine.
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_BASE_URL=https://api.anthropic.com/v1/messages
# LLM_TIMEOUT_SECONDS=5

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173
